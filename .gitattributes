# Normalisation automatique par défaut
* text=auto

# Fichiers de configuration Git
.gitattributes text eol=lf
.gitignore text eol=lf

# Fichiers texte du site web : standardisés avec fin de ligne LF
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.svg text eol=lf

# Fichiers binaires : aucun traitement de fin de ligne
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.zip binary
